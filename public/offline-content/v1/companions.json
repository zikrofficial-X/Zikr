[{"id":"6a33a3f0-3f6b-4a6c-8b21-2f0a5d0e1101","name_ar":"خديجة بنت خويلد","name_en":"Khadijah bint Khuwaylid","slug":"khadijah-bint-khuwaylid","bio_ar":"أم المؤمنين خديجة بنت خويلد رضي الله عنها زوج رسول الله ﷺ وأول من آمن به وصدّقه عند بدء الوحي. عُرفت برجاحة العقل والصدق والكرم، وكانت صاحبة تجارة ومال سخّرته في وجوه الخير. حين عاد النبي ﷺ من غار حراء خائفًا مما رأى، ثبّتته وذكّرته بما تعرفه من أخلاقه وصلة رحمه وإعانته للمحتاج. وتعرض الرواية الصحيحة في بدء الوحي موقفها وموقف ورقة بن نوفل، ولذلك تُبنى هذه الصفحة على الحديث الصحيح ولا تُضاف إليها تفاصيل شعبية بلا سند. كانت سندًا للنبي ﷺ في سنوات الدعوة الأولى، وواسته في زمن الشدة، وتوفيت قبل الهجرة على المشهور. تُظهر سيرتها اجتماع الإيمان المبكر والحكمة والوفاء وبذل المال، وتذكر القارئ بأن نصرة الحق قد تكون بالعلم والموقف والمال والرعاية. المرجع الرئيس: صحيح البخاري، كتاب بدء الوحي، حديث 3، مع الرجوع إلى كتب السيرة المحققة.","bio_en":"Khadijah bint Khuwaylid, Mother of the Believers and the first person to believe in the Prophet ﷺ.","category":"أمهات المؤمنين","thumbnail_url":null,"featured_image_url":null,"order_num":7,"published":true,"metadata":{"references":[{"url":"https://sunnah.com/bukhari:3","note_ar":"يُرجع إلى النص الكامل وسياق الرواية.","title_ar":"صحيح البخاري — بدء الوحي وقصة خديجة رضي الله عنها","locator_ar":"حديث بدء الوحي","source_type":"hadith"},{"url":"https://sunnah.com/bukhari/61","note_ar":"الفهرس العام يحتاج إلى تحديد رقم الحديث عند الاقتباس.","title_ar":"صحيح البخاري — فضائل خديجة رضي الله عنها","locator_ar":"كتاب المناقب","source_type":"hadith"}],"source_policy":"hadith_primary","content_status":"primary_indexed","editorial_scope":"source_linked_biography","source_verified":true,"editorial_status":"published","content_depth_version":1},"created_at":"2026-10-12T20:11:22.264204+00:00","updated_at":"2026-10-30T09:48:23.189956+00:00","birth_place_ar":"مكة المكرمة","death_place_ar":"مكة المكرمة","death_year":"قبل الهجرة","title_ar":null,"searchable_normalized":"'3':139 'and':153 'believe':158 'beli