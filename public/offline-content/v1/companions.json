ع محدد. عزله عمر بن الخطاب عن قيادة الجيوش لا يعني إسقاط منزلته، بل يفتح باب دراسة الفرق بين فضيلة الشخص وتنظيم المسؤولية العامة. توفي بحمص سنة 21هـ على المشهور. تعرض سيرته التحول من الخصومة إلى الإسلام وحسن القيادة والعمل ضمن الجماعة. المرجع الحديثي: صحيح البخاري، حديث 3757.","bio_en":"Original concise biography for Zikr.","category":"القادة","thumbnail_url":null,"featured_image_url":null,"order_num":306,"published":true,"metadata":{"references":[{"url":"https://sunnah.com/bukhari:3757","title_ar":"صحيح البخاري — سيف من سيوف الله","locator_ar":"حديث خالد بن الوليد","source_type":"hadith"}],"source_policy":"hadith_primary","content_status":"primary_indexed","editorial_scope":"source_linked_biography","source_verified":true,"editorial_status":"published","content_depth_version":1},"created_at":"2026-10-12T20:11:22.55942+00:00","updated_at":"2026-10-30T09:48:23.189956+00:00","birth_place_ar":null,"death_place_ar":null,"death_year":null,"title_ar":"سيف الله المسلول","searchable_normalized":"'21ه':111 '3757':131 'al':7 'al-walid':6 'biography':134 'concise':133 'for':135 'ibn':5,140 'khalid':4,139 'khalid-ibn-walid':138 'original':132 'walid':8,141 'zikr':136 'استشهاد':41 'اسقاط':95 'اسلامه':27 'اسلم':29 'الا':83 'الارقام':78 'الاسلام':120 'البخاري':129 'التاريخية':74 'التحول':116 'الثلاثة':43 'الجماعة':125 'الجيوش':92 'الحديبية':32 'الحديث':56 'الحديثي':127 'الحملات':69 'الخصومة':118 'الخطاب':89 'الردة':63 'الشام':65 'الشخص':104 'الصحابة':22 'الصحيح':57 'العامة':107 'العسكرية':25 'الفرق':101 'القادة':42,137 'القيادة':39,122 'الله':10,17,47,54 'المخزومي':15 'المرجع':126 'المسلمين':60 'المسلول':11 'المسوولية':106 'المشهور':34,113 'المصادر':73 'النبي':45 'الوليد':3,14 'الي':119 'انها':81 'باب':99 'بالمهارة':24 'بانه':50 'بحمص':109 'بعد':30,40 'بل':97 'بمرجع':84 'بن':2,13,88 'بين':102 'تختلف':71 'تعرض':77,114 'تفاصيل':68 'توفي':108 'ثم':28 'جيوش':59 'حديث':130 'حروب':62 'خالد':1,12 'دراسة':100 'رضي':16 'سنة':110 'سيرته':115 'سيف':9,51 'سيوف':53 'شارك':35 'صحيح':128 'صلح':31 'صلي':46 'ضمن':124 'عرف':23 'عزله':86 'علي':33,80,112 'عليه':48 'عمر':87 'عن':90 'عنه':18 'فضيلة':103 'في':36,55,61,72 'قاد':58 'قادة':21 'قايد':19 'قبل':26 'قطعية':82 'قيادة':91 'لا':76,93 'لذا':75 'لكن':67 'محدد':85 'من':20,52,117 'منزلته':96 'موتة':37 'والخطط':79 'والعراق':66 'والعمل':123 'وبلاد':64 'وتنظيم':105 'وتواريخها':70 'وتولي':38 'وحسن':121 'وسلم':49 'ووصفه':44 'يعني':94 'يفتح':98"},{"id":"7e0074fc-5b8b-593d-8f46-94d6d174d885","name_ar":"بلال بن رباح","name_en":"Bilal ibn Rabah","slug":"bilal-ibn-rabah","bio_ar":"بلال بن رباح الحبشي رضي الله عنه من السابقين إلى الإسلام، عانى الأذى في مكة بسبب ثباته على التوحيد، ثم أعتقه أبو بكر الصديق رضي الله عنه. صار من مؤذني رسول الله ﷺ، وارتبط اسمه بالأذان والصلاة في حياة الجماعة المسلمة. وردت في فضله أحاديث صحيحة، كما نقلت كتب السيرة أخبارًا عن صبره وتعذيبه؛ ويجب التمييز بين أصل المحنة وبين التفاصيل التي تختلف الروايات في ألفاظها. لا تنسب إليه عبارات شعبية أو مشاهد حوارية إلا إذا ثبت مصدرها. وتعرض سيرته انتقاله من الاستضعاف إلى المشاركة في بناء المجتمع، دون أن تجعل مكانته مرتبطة بالصوت وحده؛ فالأساس هو الإيمان والأمانة والثبات. تختلف المصادر في بعض تفاصيل وفاته، لذلك لا نجزم بما اختلف فيه. المرجع: صحيح البخاري في فضائل بلال، وكتب التراجم المحققة.","bio_en":"Original concise biography for Zikr.","category":"السابقون","thumbnail_url":null,"featured_image_url":null,"order_num":307,"published":true,"metadata":{"references":[{"url":"https://sunnah.com/bukhari:3754","title_ar":"صحيح البخاري — فضائل بلال رضي الله عنه","locator_ar":"حديث بلال","source_type":"hadith"}],"source_policy":"hadith_primary","content_status":"primary_indexed","editorial_scope":"source_linked_biography","source_verified":true,"editorial_status":"published","content_depth_version":1},"created_at":"2026-10-12T20:11:22.55942+00:00","updated_at":"2026-10-30T09:48:23.189956+00:00","birth_place_ar":null,"death_place_ar":null,"death_year":null,"title_ar":"مؤذن رسول الله ﷺ","searchable_normalized":"'bilal':4,145 'bilal-ibn-rabah':144 'biography':140 'conci