 المكانة الاجتماعية يمكن أن تُسخّر لحماية الضعفاء. المراجع: كتب السيرة المبكرة وتراجم الصحابة، وما صح من أحاديث الفضائل مع بيان درجة الرواية.","bio_en":"Hamzah ibn Abd al-Muttalib, the Prophet’s uncle and an early Muslim who was martyred at Uhud.","category":"آل بيت النبي والصحابة","thumbnail_url":null,"featured_image_url":null,"order_num":9,"published":true,"metadata":{"references":[{"url":"https://sunnah.com/bukhari/62","note_ar":"يجب تحديد الحديث بعينه عند النقل.","title_ar":"صحيح البخاري — فضائل أصحاب النبي ﷺ","locator_ar":"كتاب المناقب","source_type":"hadith"},{"url":"https://quran.com/3/169","note_ar":"الآية أصل عام في حياة الشهداء عند ربهم، وليست سردًا تفصيليًا لكل أحداث أُحد.","title_ar":"القرآن الكريم — منزلة الشهداء","locator_ar":"آل عمران 169","source_type":"quran"}],"source_policy":"hadith_primary","content_status":"source_indexed","editorial_scope":"source_linked_biography","source_verified":true,"editorial_status":"published","content_depth_version":1},"created_at":"2026-10-12T20:11:22.264204+00:00","updated_at":"2026-10-30T09:48:23.189956+00:00","birth_place_ar":"مكة المكرمة","death_place_ar":"جبل أُحد","death_year":"3هـ","title_ar":null,"searchable_normalized":"'3ه':55,165 'abd':7,140,169 'al':9,142,170 'al-muttalib':8,141 'an':149 'and':148 'at':155 'early':150 'hamzah':5,138,167 'hamzah-ibn-abd-al-muttalib':166 'ibn':6,139,168 'martyred':154 'muslim':151 'muttalib':10,143,171 'prophet':145 's':146 'the':144 'uhud':156 'uncle':147 'was':153 'who':152 'اثر':40 'احاديث':132 'احد':53,164 'اسانيدها':74 'اصل':88 'اظهار':42 'ال':157 'الاجتماعية':117 'الاسلام':31 'التفاصيل':91 'التي':92 'الحدث':89 'الحق':114 'الحوارات':69 'الدروس':106 'الرضاعة':27 'الروايات':97 'الرواية':137 'السابقين':29 'السيرة':58,85,125 'الشجاعة':108 'الصحابة':128 'الصفحة':79 'الضعفاء':122 'الضعيفة':98 'العامة':81 'الفضايل':133 'القصص':100 'الله':16,20,22,64 'المبكرة':126 'المتاخرة':101 'المراجع':123 'المسلمين':44 'المطلب':4,14 'المظلوم':111 'المعروفة':82 'المكانة':116 'المكرمة':162 'ا