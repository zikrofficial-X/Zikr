[{"id":"2f1d1ee1-bcd4-45d3-8160-38d214499e8b","name_ar":"الإمام أبو حنيفة النعمان بن ثابت","name_en":"Abu Hanifa","slug":"abu-hanifa","bio_ar":"أبو حنيفة النعمان بن ثابت فقيه من الكوفة، ارتبط اسمه بتشكل المدرسة الحنفية التي أصبحت من أوسع المدارس الفقهية انتشارًا. عاش في القرن الثاني الهجري، وتتحدث المصادر عن عنايته بالفقه والنظر في النوازل وتكوين الطلاب، ومن أبرز من نقل مذهبه أبو يوسف ومحمد بن الحسن الشيباني. لا يصح أن تنسب إليه كل مسألة متأخرة في كتب المذهب بوصفها رأيه الشخصي؛ فالمذهب تطور عبر أجيال من أصحابه ومحرريه. كما أن تفاصيل حياته ومواقفه مع الولاة تختلف رواياتها، ولذلك تعرض الصفحة ما تدعمه الدراسات التاريخية وتترك مواضع الخلاف موضحة. دراسة أبي حنيفة تعطي مدخلًا لفهم نشأة الفقه المدرسي وطريقة أهل العراق في الاستدلال وعلاقة الفقيه بالواقع الاجتماعي والقضائي. المرجع الأكاديمي: Encyclopaedia Iranica، مادة Abu Hanifa، إلى جانب كتب طبقات الفقهاء.","bio_en":"A jurist and scholar from Kufa who lived in the first two Islamic centuries and is associated with the Hanafi school. This profile presents his historical and legal legacy with independent references rather than treating biography as a fatwa.","thumbnail_url":null,"website_url":"https://www.iranicaonline.org/articles/abu-hanifa-noman-b","youtube_url":null,"published":true,"metadata":{"field":"الفقه وأصوله","category":"متقدمين","references":[{"url":"https://www.iranicaonline.org/articles/abu-hanifa-noman-b","title_ar":"Encyclopaedia Iranica — أبو حنيفة","source_type":"academic"}],"review_status":"editorially_reviewed_source_links","editorial_scope":"academic_and_primary_source_linked","source_verified":true,"content_depth_version":1},"created_at":"2026-11-06T19:48:57.170734+00:00","updated_at":"2026-11-06T19:49:27.387559+00:00","searchable_normalized":"'a':127,164 'abu':7,120,167 'abu-hanifa':166 'and':129,141,153 'as':163 'associated':143 'biography':162 'centuries':140 'encyclopaedia':117 'fatwa':165 'first':137 'from':131 'hanafi':146 'hanifa':8,121,168 'his':151 'historical':152 'in':135 'independent':157 '