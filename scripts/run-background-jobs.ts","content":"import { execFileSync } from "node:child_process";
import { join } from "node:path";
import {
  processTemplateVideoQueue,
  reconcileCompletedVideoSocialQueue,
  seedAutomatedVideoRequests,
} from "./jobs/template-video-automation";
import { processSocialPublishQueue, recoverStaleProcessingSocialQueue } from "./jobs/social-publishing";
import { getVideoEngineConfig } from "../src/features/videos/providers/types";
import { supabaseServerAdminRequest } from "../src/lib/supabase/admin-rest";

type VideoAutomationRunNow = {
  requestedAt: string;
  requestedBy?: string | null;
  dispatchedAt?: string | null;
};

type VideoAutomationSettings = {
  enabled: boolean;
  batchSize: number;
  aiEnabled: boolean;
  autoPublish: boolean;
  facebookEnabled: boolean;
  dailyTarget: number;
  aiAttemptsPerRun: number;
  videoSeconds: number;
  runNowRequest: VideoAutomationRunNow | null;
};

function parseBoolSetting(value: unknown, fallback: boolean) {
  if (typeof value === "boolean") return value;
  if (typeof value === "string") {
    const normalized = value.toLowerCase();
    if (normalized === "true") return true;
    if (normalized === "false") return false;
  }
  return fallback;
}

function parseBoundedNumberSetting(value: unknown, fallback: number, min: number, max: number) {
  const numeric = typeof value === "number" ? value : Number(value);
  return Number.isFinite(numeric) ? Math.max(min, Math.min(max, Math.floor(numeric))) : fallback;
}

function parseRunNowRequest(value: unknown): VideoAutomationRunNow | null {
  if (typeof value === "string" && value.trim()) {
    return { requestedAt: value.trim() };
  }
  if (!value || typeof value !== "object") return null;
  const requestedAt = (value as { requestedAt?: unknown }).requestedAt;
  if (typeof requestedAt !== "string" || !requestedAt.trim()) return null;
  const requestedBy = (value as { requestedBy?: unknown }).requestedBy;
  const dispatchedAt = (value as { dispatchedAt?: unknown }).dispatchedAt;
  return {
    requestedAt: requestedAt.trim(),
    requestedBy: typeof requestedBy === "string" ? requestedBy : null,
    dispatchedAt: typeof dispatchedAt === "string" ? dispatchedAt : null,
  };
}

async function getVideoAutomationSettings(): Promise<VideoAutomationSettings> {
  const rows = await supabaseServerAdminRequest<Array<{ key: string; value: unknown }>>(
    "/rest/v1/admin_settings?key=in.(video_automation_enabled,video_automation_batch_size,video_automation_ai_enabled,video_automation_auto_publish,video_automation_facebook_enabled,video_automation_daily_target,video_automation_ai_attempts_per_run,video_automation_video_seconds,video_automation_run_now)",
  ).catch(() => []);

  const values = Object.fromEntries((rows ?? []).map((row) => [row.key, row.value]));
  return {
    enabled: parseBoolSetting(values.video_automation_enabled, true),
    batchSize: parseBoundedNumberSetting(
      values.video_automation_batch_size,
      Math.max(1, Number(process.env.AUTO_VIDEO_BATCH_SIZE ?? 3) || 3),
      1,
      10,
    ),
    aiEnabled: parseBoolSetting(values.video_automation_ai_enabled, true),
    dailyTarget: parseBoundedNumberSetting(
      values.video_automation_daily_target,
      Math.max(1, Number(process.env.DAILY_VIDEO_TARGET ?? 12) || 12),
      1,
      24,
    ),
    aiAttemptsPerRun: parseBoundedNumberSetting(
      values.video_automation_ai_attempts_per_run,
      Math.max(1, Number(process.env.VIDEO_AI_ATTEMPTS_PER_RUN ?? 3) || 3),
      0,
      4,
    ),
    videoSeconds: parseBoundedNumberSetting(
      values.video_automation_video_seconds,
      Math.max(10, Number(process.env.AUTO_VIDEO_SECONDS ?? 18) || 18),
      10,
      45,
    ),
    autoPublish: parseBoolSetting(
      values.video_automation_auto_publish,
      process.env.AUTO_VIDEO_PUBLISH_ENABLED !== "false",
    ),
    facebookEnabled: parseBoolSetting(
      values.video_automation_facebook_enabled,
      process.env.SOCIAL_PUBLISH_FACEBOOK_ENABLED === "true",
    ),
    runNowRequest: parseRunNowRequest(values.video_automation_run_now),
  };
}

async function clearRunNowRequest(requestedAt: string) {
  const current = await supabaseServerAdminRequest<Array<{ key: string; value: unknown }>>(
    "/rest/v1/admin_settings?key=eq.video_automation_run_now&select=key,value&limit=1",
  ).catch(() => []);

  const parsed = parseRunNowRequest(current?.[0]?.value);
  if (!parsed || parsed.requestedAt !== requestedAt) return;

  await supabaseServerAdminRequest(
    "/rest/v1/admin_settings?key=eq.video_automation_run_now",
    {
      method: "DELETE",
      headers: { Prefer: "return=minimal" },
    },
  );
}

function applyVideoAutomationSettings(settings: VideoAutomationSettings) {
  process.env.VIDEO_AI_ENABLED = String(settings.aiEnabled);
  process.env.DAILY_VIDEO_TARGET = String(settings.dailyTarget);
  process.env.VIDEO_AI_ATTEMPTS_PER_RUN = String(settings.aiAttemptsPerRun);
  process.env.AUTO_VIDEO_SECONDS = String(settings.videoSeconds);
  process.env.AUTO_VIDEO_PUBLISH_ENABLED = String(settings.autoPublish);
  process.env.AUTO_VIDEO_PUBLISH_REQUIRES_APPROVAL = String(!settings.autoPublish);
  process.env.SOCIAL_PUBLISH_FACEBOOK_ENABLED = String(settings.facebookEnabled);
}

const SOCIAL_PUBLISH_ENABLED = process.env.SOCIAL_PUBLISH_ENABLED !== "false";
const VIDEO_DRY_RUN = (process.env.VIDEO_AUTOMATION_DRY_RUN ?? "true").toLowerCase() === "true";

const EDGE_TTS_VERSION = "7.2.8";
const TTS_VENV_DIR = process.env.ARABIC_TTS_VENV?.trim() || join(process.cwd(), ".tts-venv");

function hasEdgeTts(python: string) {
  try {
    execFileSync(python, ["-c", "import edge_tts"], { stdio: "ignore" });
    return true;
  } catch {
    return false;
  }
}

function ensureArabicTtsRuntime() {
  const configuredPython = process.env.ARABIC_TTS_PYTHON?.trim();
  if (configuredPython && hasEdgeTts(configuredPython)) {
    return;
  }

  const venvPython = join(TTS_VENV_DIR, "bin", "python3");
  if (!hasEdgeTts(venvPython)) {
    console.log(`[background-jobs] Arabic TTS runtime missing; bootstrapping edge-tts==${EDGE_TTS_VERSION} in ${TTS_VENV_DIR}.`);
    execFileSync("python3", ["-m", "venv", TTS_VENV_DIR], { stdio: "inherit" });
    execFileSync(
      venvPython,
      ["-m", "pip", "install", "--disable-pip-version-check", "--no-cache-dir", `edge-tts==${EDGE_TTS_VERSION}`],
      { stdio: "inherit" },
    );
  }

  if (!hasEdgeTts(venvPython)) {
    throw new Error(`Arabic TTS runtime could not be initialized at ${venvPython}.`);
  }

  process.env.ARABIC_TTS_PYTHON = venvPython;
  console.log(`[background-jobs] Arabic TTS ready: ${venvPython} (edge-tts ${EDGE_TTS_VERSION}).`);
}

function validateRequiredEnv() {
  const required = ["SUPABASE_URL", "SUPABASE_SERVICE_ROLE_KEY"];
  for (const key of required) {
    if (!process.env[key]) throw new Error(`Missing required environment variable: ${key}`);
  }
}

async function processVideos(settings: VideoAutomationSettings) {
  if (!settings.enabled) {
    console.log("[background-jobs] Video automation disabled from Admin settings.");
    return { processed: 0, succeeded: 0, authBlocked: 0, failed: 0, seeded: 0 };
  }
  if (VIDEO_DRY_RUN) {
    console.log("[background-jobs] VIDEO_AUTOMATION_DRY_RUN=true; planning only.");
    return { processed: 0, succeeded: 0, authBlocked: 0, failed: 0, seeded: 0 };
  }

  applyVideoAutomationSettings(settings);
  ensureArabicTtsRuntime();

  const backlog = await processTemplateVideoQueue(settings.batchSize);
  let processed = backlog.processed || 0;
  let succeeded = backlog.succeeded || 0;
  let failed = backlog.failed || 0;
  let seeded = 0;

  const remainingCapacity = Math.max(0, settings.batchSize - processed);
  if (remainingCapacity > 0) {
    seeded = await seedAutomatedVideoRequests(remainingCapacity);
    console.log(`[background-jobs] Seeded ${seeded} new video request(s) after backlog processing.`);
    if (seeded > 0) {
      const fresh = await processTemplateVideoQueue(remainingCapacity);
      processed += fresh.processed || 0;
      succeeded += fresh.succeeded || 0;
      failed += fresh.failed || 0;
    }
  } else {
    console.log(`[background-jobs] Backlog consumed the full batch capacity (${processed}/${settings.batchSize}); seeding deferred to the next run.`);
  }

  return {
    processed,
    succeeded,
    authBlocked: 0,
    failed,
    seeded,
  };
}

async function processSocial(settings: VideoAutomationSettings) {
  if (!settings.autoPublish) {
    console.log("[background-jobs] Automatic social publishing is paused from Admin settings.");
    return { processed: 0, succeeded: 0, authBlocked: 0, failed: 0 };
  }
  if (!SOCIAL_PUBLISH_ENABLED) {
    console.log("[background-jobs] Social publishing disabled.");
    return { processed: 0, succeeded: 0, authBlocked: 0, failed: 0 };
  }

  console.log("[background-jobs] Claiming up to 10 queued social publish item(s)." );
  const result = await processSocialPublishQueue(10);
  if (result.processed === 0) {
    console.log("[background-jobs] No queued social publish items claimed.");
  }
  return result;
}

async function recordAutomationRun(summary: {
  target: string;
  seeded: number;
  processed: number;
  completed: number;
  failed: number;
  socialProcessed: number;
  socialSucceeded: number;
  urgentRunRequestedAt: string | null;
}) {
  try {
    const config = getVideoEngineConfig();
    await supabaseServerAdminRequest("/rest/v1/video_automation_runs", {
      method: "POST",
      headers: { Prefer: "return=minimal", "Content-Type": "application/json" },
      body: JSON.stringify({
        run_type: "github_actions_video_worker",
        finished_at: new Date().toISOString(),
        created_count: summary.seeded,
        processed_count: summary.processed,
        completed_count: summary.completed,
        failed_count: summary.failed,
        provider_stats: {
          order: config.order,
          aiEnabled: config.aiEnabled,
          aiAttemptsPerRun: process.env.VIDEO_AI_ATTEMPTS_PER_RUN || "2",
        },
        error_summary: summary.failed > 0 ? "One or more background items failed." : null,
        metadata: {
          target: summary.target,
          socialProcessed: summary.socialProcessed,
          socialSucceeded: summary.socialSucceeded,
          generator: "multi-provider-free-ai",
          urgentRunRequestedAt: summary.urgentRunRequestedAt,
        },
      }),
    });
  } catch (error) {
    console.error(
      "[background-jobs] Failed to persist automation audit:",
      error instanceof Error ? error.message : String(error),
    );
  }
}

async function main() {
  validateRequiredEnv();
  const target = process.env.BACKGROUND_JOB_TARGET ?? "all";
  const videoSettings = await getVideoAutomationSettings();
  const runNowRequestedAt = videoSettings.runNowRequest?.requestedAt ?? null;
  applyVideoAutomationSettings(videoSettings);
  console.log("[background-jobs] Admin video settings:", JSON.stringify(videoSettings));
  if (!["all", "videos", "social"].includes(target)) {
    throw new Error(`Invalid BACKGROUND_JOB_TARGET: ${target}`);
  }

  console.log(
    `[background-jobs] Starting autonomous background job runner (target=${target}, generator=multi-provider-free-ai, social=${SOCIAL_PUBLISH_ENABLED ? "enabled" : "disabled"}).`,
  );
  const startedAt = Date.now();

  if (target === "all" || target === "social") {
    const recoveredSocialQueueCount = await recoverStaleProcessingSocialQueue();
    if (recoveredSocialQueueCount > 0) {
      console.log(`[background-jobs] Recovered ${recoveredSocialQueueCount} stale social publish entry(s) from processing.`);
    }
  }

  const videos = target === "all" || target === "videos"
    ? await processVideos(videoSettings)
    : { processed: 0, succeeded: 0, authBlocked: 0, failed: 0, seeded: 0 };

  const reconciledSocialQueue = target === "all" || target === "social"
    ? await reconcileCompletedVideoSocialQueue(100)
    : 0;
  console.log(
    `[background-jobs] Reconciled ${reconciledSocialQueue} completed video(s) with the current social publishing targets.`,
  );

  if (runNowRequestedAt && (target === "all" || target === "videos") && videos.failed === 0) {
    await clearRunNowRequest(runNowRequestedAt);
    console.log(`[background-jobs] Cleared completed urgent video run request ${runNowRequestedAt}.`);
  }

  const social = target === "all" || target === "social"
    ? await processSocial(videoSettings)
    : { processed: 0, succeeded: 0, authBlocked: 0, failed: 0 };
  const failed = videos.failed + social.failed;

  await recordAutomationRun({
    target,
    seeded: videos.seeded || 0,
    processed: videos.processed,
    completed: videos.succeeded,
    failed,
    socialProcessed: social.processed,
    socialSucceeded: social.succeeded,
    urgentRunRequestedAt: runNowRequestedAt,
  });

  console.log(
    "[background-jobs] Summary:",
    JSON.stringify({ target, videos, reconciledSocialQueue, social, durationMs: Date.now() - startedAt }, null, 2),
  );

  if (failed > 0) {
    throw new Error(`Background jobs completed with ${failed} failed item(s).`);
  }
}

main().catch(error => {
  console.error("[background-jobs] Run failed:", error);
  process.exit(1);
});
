import {
  claimPendingSocialPublishItems,
  processSocialPublishItem,
} from "../../src/features/social/services/social-publishing";
import { supabaseServerAdminRequest } from "../../src/lib/supabase/admin-rest";

export async function recoverStaleProcessingSocialQueue(limit = 50): Promise<number> {
  try {
    const staleThreshold = new Date(Date.now() - 30 * 60 * 1000).toISOString();
    const staleRows = await supabaseServerAdminRequest<Array<{
      id: string;
      updated_at: string;
      metadata: Record<string, unknown> | null;
    }>>(
      `/rest/v1/social_publish_queue?status=eq.processing&updated_at=lt.${encodeURIComponent(staleThreshold)}&select=id,updated_at,metadata&limit=${Math.max(1, Math.min(limit, 100))}`,
    ).catch(() => []);

    if (!Array.isArray(staleRows) || staleRows.length === 0) return 0;

    for (const row of staleRows) {
      const currentMetadata = row.metadata ?? {};
      await supabaseServerAdminRequest(
        `/rest/v1/social_publish_queue?id=eq.${encodeURIComponent(row.id)}`,
        {
          method: "PATCH",
          headers: { "Content-Type": "application/json", Prefer: "return=minimal" },
          body: JSON.stringify({
            status: "partial",
            scheduled_at: new Date(Date.now() + 5 * 60 * 1000).toISOString(),
            error_message: "Recovered stale processing item after 30-minute timeout.",
            updated_at: new Date().toISOString(),
            metadata: {
              ...currentMetadata,
              attempts: Number((currentMetadata as { attempts?: unknown })?.attempts ?? 0) + 1,
              maxAttempts: Number((currentMetadata as { maxAttempts?: unknown })?.maxAttempts ?? 5),
              staleRecovery: true,
              staleRecoveryAt: new Date().toISOString(),
              lastErrorAt: new Date().toISOString(),
            },
          }),
        },
      );
    }

    return staleRows.length;
  } catch (error) {
    console.error("[social-publishing] Failed to recover stale processing queue entries:", error);
    return 0;
  }
}

export async function processSocialPublishQueue(limit = 10) {
  const items = await claimPendingSocialPublishItems(limit);
  let succeeded = 0;
  let authBlocked = 0;
  let failed = 0;

  for (const item of items) {
    const outcome = await processSocialPublishItem(item, { alreadyClaimed: true });
    if (outcome === "published") succeeded += 1;
    else if (outcome === "auth_blocked") authBlocked += 1;
    else failed += 1;
  }

  return { processed: items.length, succeeded, authBlocked, failed };
}
