{
  "name": "zikr",
  "version": "1.4.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "test": "tsx --test __tests__/unit/*.test.ts __tests__/integration/*.test.ts",
    "format": "prettier --write .",
    "db:migrate:supabase": "pnpm dlx supabase db push",
    "lint": "eslint .",
    "deploy:check": "node scripts/validate-deployment-env.mjs",
    "cap": "cap",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "mobile:prepare": "node scripts/prepare-mobile-assets.mjs",
    "mobile:build": "pnpm build && pnpm mobile:prepare && pnpm cap:sync",
    "mobile:sync": "pnpm build && pnpm mobile:prepare && pnpm exec cap sync",
    "mobile:android:debug": "pnpm mobile:sync && cd android && ./gradlew assembleDebug",
    "mobile:android:release": "pnpm mobile:sync && cd android && ./gradlew bundleRelease",
    "mobile:ios:open": "pnpm mobile:sync && pnpm exec cap open ios",
    "mobile:check": "node scripts/verify-mobile-readiness.mjs",
    "verify-mobile-readiness": "node scripts/verify-mobile-readiness.mjs",
    "offline:check": "node scripts/verify-offline-content.mjs",
    "project:check": "node scripts/verify-project-integrity.mjs",
    "mobile:release-check": "MOBILE_RELEASE_CHECK=1 node scripts/verify-mobile-readiness.mjs",
    "supabase:migrations:check": "node scripts/validate-migrations.mjs",
    "supabase:migrations:replay": "SIMULATE_LEGACY=1 node scripts/validate-migrations.mjs",
    "routes:check": "node scripts/verify-platform-routes.mjs",
    "adsense:check": "node scripts/verify-adsense-readiness.mjs",
    "verify": "pnpm supabase:migrations:check && pnpm supabase:migrations:replay && pnpm routes:check && pnpm imports:check && pnpm placeholder-media:check && pnpm mobile:check && pnpm offline:check && pnpm project:check && pnpm adsense:check && pnpm lint && pnpm check && pnpm test && pnpm build",
    "imports:check": "node scripts/verify-local-imports.mjs",
    "placeholder-media:check": "node scripts/verify-placeholder-media.mjs",
    "background:jobs": "tsx scripts/run-background-jobs.ts",
    "automation:run": "tsx scripts/run-background-jobs.ts",
    "launch:smoke": "node scripts/production-smoke-test.mjs",
    "launch:smoke:strict": "STRICT_PROD_SMOKE=1 node scripts/production-smoke-test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
