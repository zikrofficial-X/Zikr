{
  "name": "zikr",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/ensure-ffmpeg.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "db:migrate-supabase": "pnpm dlx supabase db push",
    "lint": "eslint .",
    "deploy:check": "node scripts/validate-deployment-env.mjs",
    "release:metadata": "node scripts/verify-release-metadata.mjs",
    "cap": "cap",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "mobile:prepare": "node scripts/prepare-mobile-assets.mjs",
    "mobile:build": "pnpm build && pnpm mobile:prepare && pnpm cap:sync",
    "mobile:sync": "pnpm build && pnpm mobile:prepare && pnpm exec cap sync",
    "mobile:android:debug": "pnpm mobile:sync && cd android && ./gradlew assembleDebug",
    "mobile:android:release": "pnpm mobile:sync && cd android && ./gradlew bundleRelease",
    "mobile:ios:open": "pnpm mobile:sync && pnpm exec cap open ios",
    "mobile:check": "node scripts/verify-mobile-readiness.mjs",
    "verify-mobile-readiness": "node scripts/verify-mobile-readiness.mjs",
    "offline:check": "node scripts/verify-offline-content.mjs",
    "project:check": "node scripts/verify-project-integrity.mjs",
    "supabase:migrations:check": "node scripts/validate-migrations.mjs",
    "supabase:migrations:replay": "SIMULATE_LEGACY=1 node scripts/validate-migrations.mjs",
    "routes:check": "node scripts/verify-platform-routes.mjs",
    "native-social:check": "node scripts/verify-native-social-sync.mjs",
    "adsense:check": "node scripts/verify-adsense-readiness.mjs",
    "search-console:check": "node scripts/verify-google-search-console.mjs",
    "hygiene:check": "node scripts/verify-hygiene.mjs",
    "verify": "pnpm supabase:migrations:check && pnpm quran:local:check && pnpm supabase:migrations:replay && pnpm routes:check && pnpm imports:check && pnpm placeholder-media:check && pnpm mobile:check && pnpm offline:check && pnpm content:check && pnpm auth:check && pnpm canonical:check && pnpm project:check && pnpm hygiene:check && pnpm native-social:check && pnpm adsense:check && pnpm search-console:check && pnpm lint && pnpm check && pnpm build",
    "imports:check": "node scripts/verify-local-imports.mjs",
    "placeholder-media:check": "node scripts/verify-placeholder-media.mjs",
    "background:jobs": "tsx scripts/run-background-jobs.ts",
    "social:backfill:native": "node scripts/import-youtube-takeout-native-facebook.mjs",
    "content:check": "node scripts/verify-content-integrity.mjs",
    "auth:check": "node scripts/verify-auth-config.mjs",
    "canonical:check": "node scripts/verify-canonical-config.mjs",
    "quran:local:check": "node scripts/verify-local-quran.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/app": "7.0.2",
    "@capacitor/browser": "7.0.5",
    "@capacitor/camera": "7.0.2",
    "@capacitor/core": "7.4.3",
    "@capacitor/filesystem": "7.1.8",
    "@capacitor/geolocation": "^7.1.0",
    "@capacitor/haptics": "7.0.5",
    "@capacitor/ios": "7.4.3",
    "@capacitor/keyboard": "7.0.3",
    "@capacitor/local-notifications": "7.0.2",
    "@capacitor/network": "7.0.2",
    "@capacitor/preferences": "7.0.2",
    "@capacitor/push-notifications": "7.0.3",
    "@capacitor/share": "7.0.4",
    "@capacitor/splash-screen": "7.0.5",
    "@capacitor/status-bar": "7.0.2",
    "@capawesome/capacitor-background-task": "7.0.1",
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.66",
    "clsx": "2.1.1",
    "lucide-react": "^1.39.0",
    "next": "^16.3.5",
    "phaser": "^3.90.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.6.1",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@9.15.0"
}
