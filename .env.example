# ZIKR — canonical environment variables
# Copy to .env.local and fill in real values. Never commit secrets.

# ── Core site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zikrmediaofficial.vercel.app

# ── Supabase ─────────────────────────────────────────────────────────────────
# Web/runtime:
NEXT_PUBLIC_SUPABASE_URL=https://kdotmrjfecgafiommzwz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Background workers / CI compatibility:
SUPABASE_URL=https://kdotmrjfecgafiommzwz.supabase.co
SUPABASE_ANON_KEY=

# ── Authentication ──────────────────────────────────────────────────────────
# App callback after Supabase completes OAuth.
AUTH_CALLBACK_URL=https://zikrmediaofficial.vercel.app/auth/callback
# Google OAuth provider credentials are managed in Supabase Dashboard → Authentication.

# ── YouTube publishing ──────────────────────────────────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── Facebook / Meta publishing ─────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v26.0
NATIVE_SOCIAL_SYNC_ENABLED=false

# ── Video automation ────────────────────────────────────────────────────────
VIDEO_GENERATOR=template
VIDEO_AUTO_PUBLISH=false
VIDEO_BACKGROUND_BATCH_SIZE=3
SOCIAL_BACKGROUND_BATCH_SIZE=10
SOCIAL_PUBLISH_ENABLED=true
VIDEO_PROVIDER_ORDER=template,comfyui,free_api
VIDEO_AI_ENABLED=false
COMFYUI_ENABLED=false
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_MS=120000
COMFYUI_MODEL=wan2.1
COMFYUI_WAN_WORKFLOW_JSON=
COMFYUI_LTX_WORKFLOW_JSON=
FREE_VIDEO_PROVIDER_ENABLED=false
FREE_VIDEO_PROVIDER_URL=
FREE_VIDEO_PROVIDER_TOKEN=
VIDEO_DAILY_LIMIT=10
VIDEO_MAX_RETRIES=3
VIDEO_STALE_AFTER_MINUTES=30
VIDEO_DEFAULT_FORMAT=vertical
VIDEO_DEFAULT_DURATION=8
VIDEO_TIMEZONE=Asia/Riyadh
VIDEO_AUTOMATION_DRY_RUN=true
DAILY_VIDEO_TARGET=5
AUTO_VIDEO_ENABLED=false
AUTO_VIDEO_BATCH_SIZE=1
AUTO_VIDEO_SECONDS=14
VIDEO_AI_ATTEMPTS_PER_RUN=2
HF_WAN_VIDEO_ENABLED=false
HF_LTX_FAST_VIDEO_ENABLED=false
HF_WAN_SPACE=zerogpu-aoti/wan2-2-fp8da-aoti-faster
HF_LTX_FAST_SPACE=Lightricks/ltx-video-distilled
HF_VIDEO_PYTHON=
HF_TOKEN=
VERIFY_VIDEO_RUNTIME_TOOLS=false
BACKGROUND_JOB_TARGET=all
VIDEO_TEMPLATE_VERSION=2026-10-02-quality-v2
VIDEO_PUBLISH_SCHEDULE=
AUTO_VIDEO_PUBLISH_ENABLED=false
AUTO_VIDEO_PUBLISH_REQUIRES_APPROVAL=true
INTERNAL_JOB_SECRET=
YOUTUBE_SYNC_SECRET=

# ── AI ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional Vercel AI Gateway credential when that provider path is explicitly enabled.
AI_GATEWAY_API_KEY=

# ── Media ───────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Islamic content API ─────────────────────────────────────────────────────
HADITH_API_BASE_URL=https://ummahapi.com/api/hadith

# ── Analytics / search / ads ─────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=

# ── Kids ────────────────────────────────────────────────────────────────────
KIDS_CONTENT_SHAREABLE=true
KIDS_FACEBOOK_SHARE_ENABLED=false
KIDS_YOUTUBE_INTEGRATION_ENABLED=false
NEXT_PUBLIC_KIDS_CONTENT_SHAREABLE=true
NEXT_PUBLIC_KIDS_SHARE_MESSAGE=شارك هذا المحتوى التعليمي الإسلامي الرائع مع عائلتك

# ── Supabase Edge Functions / Push ─────────────────────────────────────────
# Prayer worker required credentials are supplied by the Supabase runtime.
# Optional override; the prayer worker has the same canonical fallback.
PUSH_CONTACT=mailto:admin@zikrmediaofficial.vercel.app

# ── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=
