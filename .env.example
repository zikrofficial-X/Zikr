# ══════════════════════════════════════════════════════════════════════════════
# ZIKR MEDIA – Environment Variables Reference
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# NEXT_PUBLIC_* prefixes are safe to expose to the browser.
# All other variables are server-only – NEVER commit real values.

# ── CRITICAL: Site Configuration ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zikrmediaofficial.vercel.app

# ── CRITICAL: Supabase Configuration ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://eydxvcamhjhajxjrsgym.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=https://eydxvcamhjhajxjrsgym.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# ── CRITICAL: PostgreSQL Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_DATABASE=postgres

# ── CRITICAL: Authentication & OAuth ───────────────────────────────────────────
AUTH_CALLBACK_URL=https://zikrmediaofficial.vercel.app/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── YouTube ─────────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── Facebook / Meta ─────────────────────────────────────────────────────────────
# Server-only. Never expose page access tokens to browser code.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_GRAPH_API_VERSION=v26.0

# Native cross-posting is intentionally separate from generic video generation.
# The native publisher MUST receive a real HTTPS media URL and MUST NOT publish
# YouTube watch URLs as Facebook link posts.
NATIVE_SOCIAL_SYNC_ENABLED=false

# ── Video automation ────────────────────────────────────────────────────────────
# Production generation is intentionally locked to the free FFmpeg renderer.
# No HeyGen credentials or paid video provider is required.
VIDEO_GENERATOR=template
VIDEO_AUTO_PUBLISH=true
VIDEO_PUBLISH_SCHEDULE=
VIDEO_BACKGROUND_BATCH_SIZE=3
SOCIAL_BACKGROUND_BATCH_SIZE=10
SOCIAL_PUBLISH_ENABLED=true

# ── Kids Content Social Features ───────────────────────────────────────────────
KIDS_CONTENT_SHAREABLE=true
KIDS_FACEBOOK_SHARE_ENABLED=true
KIDS_YOUTUBE_INTEGRATION_ENABLED=true
NEXT_PUBLIC_KIDS_CONTENT_SHAREABLE=true
NEXT_PUBLIC_KIDS_SHARE_MESSAGE=شارك هذا المحتوى التعليمي الإسلامي الرائع مع عائلتك

# ── Gemini AI Integration ──────────────────────────────────────────────────────
# Gemini may be used for AI-assisted content generation, but it is not required
# to render the production Quran video file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Islamic Content APIs ───────────────────────────────────────────────────────
QURAN_API_BASE_URL=https://api.alquran.cloud/v1
QURAN_AUDIO_CDN_URL=https://cdn.islamic.network/quran/audio
HADITH_API_BASE_URL=https://hadithapi.com/api
NEXT_PUBLIC_QURAN_API=https://api.alquran.cloud/v1
NEXT_PUBLIC_HADITH_API=https://hadithapi.com/api

# ── Google Ads & Analytics ────────────────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX

# ── AI Gateway ──────────────────────────────────────────────────────────────────
AI_GATEWAY_API_KEY=

# ── Media Storage ───────────────────────────────────────────────────────────────
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=us-east-1
AWS_S3_PUBLIC_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Vercel KV ───────────────────────────────────────────────────────────────────
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Webhook Signing ────────────────────────────────────────────────────────────
WEBHOOK_SECRET=your-webhook-secret-here
