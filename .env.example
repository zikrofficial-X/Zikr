# ══════════════════════════════════════════════════════════════════════════════
# ZIKR MEDIA – Environment Variables Reference
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# NEXT_PUBLIC_* prefixes are safe to expose to the browser.
# All other variables are server-only – NEVER commit real values.
#
# Generation Date: July 31, 2026
# Version: 1.0.0 Production Ready
# ══════════════════════════════════════════════════════════════════════════════

# ── CRITICAL: Site Configuration ───────────────────────────────────────────────
# Canonical origin of the deployment. Used for all URLs and redirects.
NEXT_PUBLIC_SITE_URL=https://zikrmediaofficial.vercel.app

# ── CRITICAL: Supabase Configuration ───────────────────────────────────────────
# Browser client uses the NEXT_PUBLIC_* keys (safe to expose).
# Server auth also accepts SUPABASE_URL and SUPABASE_ANON_KEY aliases.
# Get from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Server-only – NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# ── CRITICAL: PostgreSQL Database ──────────────────────────────────────────────
# Used by Drizzle ORM and scripts. Supports both connection pooling and direct.
# Get from: Supabase Dashboard > Project Settings > Database
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_URL=postgresql://postgres.xxxxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
# Prisma/Supabase pooler URL should include pgbouncer=true when using port 6543.
POSTGRES_PRISMA_URL=postgresql://postgres.xxxxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# Non-pooling/direct Supabase connection should use the direct database endpoint/port.
POSTGRES_URL_NON_POOLING=postgresql://postgres.xxxxx:password@db.xxxxx.supabase.co:5432/postgres?sslmode=require
POSTGRES_USER=postgres.xxxxx
POSTGRES_PASSWORD=
POSTGRES_HOST=aws-0-eu-west-1.pooler.supabase.com
POSTGRES_DATABASE=postgres

# ── CRITICAL: Authentication & OAuth ───────────────────────────────────────────
# App callback URL used by Supabase Auth redirectTo.
# Do NOT set this to https://<project>.supabase.co/auth/v1/callback in Vercel;
# Google Cloud still needs the Supabase provider callback registered separately.
AUTH_CALLBACK_URL=https://zikrmediaofficial.vercel.app/auth/callback

# Google OAuth (Get from: Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Facebook Integration (Optional – for social sharing & kids content)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# ── YouTube Integration (Optional but recommended) ────────────────────────────
# Get from: Google Cloud Console > YouTube Data API
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Automatic cross-posting is enabled when provider credentials are present.
# Set to false only for a deliberate site-only generation workflow.
VIDEO_AUTO_PUBLISH=true
VIDEO_PUBLISH_SCHEDULE=

# ── Kids Content Social Features ───────────────────────────────────────────────
# Social sharing and engagement for kids educational content
KIDS_CONTENT_SHAREABLE=true
KIDS_FACEBOOK_SHARE_ENABLED=true
KIDS_YOUTUBE_INTEGRATION_ENABLED=true
NEXT_PUBLIC_KIDS_CONTENT_SHAREABLE=true
NEXT_PUBLIC_KIDS_SHARE_MESSAGE=شارك هذا المحتوى التعليمي الإسلامي الرائع مع عائلتك

# ── Gemini AI Integration (Optional) ───────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Islamic Content APIs ───────────────────────────────────────────────────────
# Default APIs with fallbacks – no setup needed unless you want custom ones
QURAN_API_BASE_URL=https://api.alquran.cloud/v1
QURAN_AUDIO_CDN_URL=https://cdn.islamic.network/quran/audio
HADITH_API_BASE_URL=https://hadithapi.com/api
NEXT_PUBLIC_QURAN_API=https://api.alquran.cloud/v1
NEXT_PUBLIC_HADITH_API=https://hadithapi.com/api

# ── Google Ads & Analytics ────────────────────────────────────────────────────
# AdSense (Optional – for monetization)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# Google Analytics 4 (Set directly in Google Analytics dashboard)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── AI Gateway (Vercel) ─────────────────────────────────────────────────────────
# Optional: For advanced AI features through Vercel AI Gateway
AI_GATEWAY_API_KEY=

# ── Media Storage: AWS S3 (Optional) ───────────────────────────────────────────
# Get from: AWS IAM Console
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=us-east-1
AWS_S3_PUBLIC_BASE_URL=https://s3.amazonaws.com/your-bucket

# ── Video Generation: HeyGen (Optional) ────────────────────────────────────────
# Get from: HeyGen Dashboard
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# ── Cloudinary Image Storage (server-only) ─────────────────────────────────────
# Get from: Cloudinary Console > Product Environment Credentials
# Do not use NEXT_PUBLIC_ names or expose the API secret to browser code.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Vercel KV (Optional – for caching/sessions) ────────────────────────────────
# Get from: Vercel Dashboard > Storage > KV
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Webhook Signing (Internal) ────────────────────────────────────────────────
# Auto-generated – never change
WEBHOOK_SECRET=your-webhook-secret-here
