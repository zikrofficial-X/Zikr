# ZIKR — canonical environment variables
# Copy to .env.local and fill in real values. Never commit secrets.

# ── Core site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zikrmediaofficial.vercel.app
NEXT_PUBLIC_VERCEL_ENV=

# ── Supabase ─────────────────────────────────────────────────────────────────
# Web/runtime:
NEXT_PUBLIC_SUPABASE_URL=https://ymxdswkaxafakugktsim.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_KEY=
# Background workers / CI compatibility:
SUPABASE_URL=https://ymxdswkaxafakugktsim.supabase.co
SUPABASE_ANON_KEY=

# ── Authentication ──────────────────────────────────────────────────────────
# App callback after Supabase completes OAuth.
AUTH_CALLBACK_URL=https://zikrmediaofficial.vercel.app/auth/callback
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
# Google OAuth provider credentials are managed in Supabase Dashboard → Authentication.

